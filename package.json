{
  "name": "forgepilot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ForgePilot control plane: API, closed-loop engine, workers and connectors.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/cli.ts migrate",
    "seed:demo": "tsx src/cli.ts seed-demo",
    "openapi": "tsx src/cli.ts openapi",
    "contract:sync": "node scripts/sync-contract.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
