# Copy to .env for local development. Every variable is validated at boot (src/config.ts).

# --- core
NODE_ENV=development
PORT=8080
# all = API + workers in one process. Split into `api` and `worker` in production.
ROLE=all
# Real Postgres, or pglite://.data/pg for a zero-setup local database.
DATABASE_URL=pglite://.data/pg
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080/api/v1
CORS_ORIGINS=
COOKIE_SECURE=false
# 32 random bytes, base64. Required in production: encrypts integration credentials.
VAULT_KEY=

# --- demo
# Fictional workspaces, persona sign-in and "reset demo data". Never with real customers.
DEMO_MODE=true

# --- execution
# simulated = stand-ins for agents/tests/scans. live = real GitHub, agents and test runs.
EXECUTION_MODE=simulated
EXECUTION_SANDBOX=docker
WORKER_CONCURRENCY=4
WORKSPACE_ROOT=/tmp/forgepilot-workspaces

# --- GitHub App (repositories, PRs, check runs, webhooks) and OAuth (sign in with GitHub)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# {"developer":{"monthly":"price_…","annual":"price_…"},"pro":{…},"team":{…},"business":{…}}
STRIPE_PRICES=

# --- email (Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=ForgePilot <no-reply@example.com>
